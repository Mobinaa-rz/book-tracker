# Copy this file to `.env` and adjust the values.
# `.env` is ignored by Git - never commit real secrets.

# Port the API listens on
PORT=4000

# Secret used to sign JWT session cookies.
# Use a long random string in production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Path to the SQLite database file (relative to the backend/ directory).
# Use ":memory:" for a throwaway in-memory database.
DB_PATH=data/books.db

# "development" or "production" (production marks the cookie as Secure)
NODE_ENV=development
